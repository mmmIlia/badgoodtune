APP_ENV=development
HTTP_ADDRESS=:8080
METRICS_ADDRESS=:9090
METRICS_READ_HEADER_TIMEOUT=5s
METRICS_WRITE_TIMEOUT=10s
METRICS_IDLE_TIMEOUT=30s
DATABASE_URL=postgres://badgoodtune:badgoodtune@postgres:5432/badgoodtune?sslmode=disable
COOKIE_NAME=badgoodtune_session
COOKIE_SECURE=false
SESSION_TTL=168h
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
READINESS_TIMEOUT=1s
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=5s
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
ARGON2_MAX_CONCURRENT=2
LOG_LEVEL=info

POSTGRES_DB=badgoodtune
POSTGRES_USER=badgoodtune
POSTGRES_PASSWORD=badgoodtune
